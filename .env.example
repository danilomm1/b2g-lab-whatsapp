# Copie para .env e preencha. Nunca versione o .env.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Chave Fernet para criptografar tokens: python manage.py generate_encryption_key
# Na rotação, use "nova,antiga" e rode python manage.py reencrypt_credentials
FIELD_ENCRYPTION_KEY=

# Segurança operacional do laboratório
LAB_DRY_RUN=True
# Telefones (E.164) ou emails separados por vírgula
LAB_ALLOWED_RECIPIENTS=
LAB_MAX_PROACTIVE_PER_WEEK=3
# Segredo HMAC do webhook de teste (provedor lab): python manage.py send_test_webhook
LAB_WEBHOOK_SECRET=

# Meta (Facebook, Instagram, Threads). Passo a passo em docs/integrations/meta.md
# App ID e App Secret: App Dashboard > Configurações do app > Básico
META_APP_ID=
META_APP_SECRET=
# Token do System User (Business Manager > Usuários do sistema > Gerar token)
META_SYSTEM_USER_TOKEN=
# Texto aleatório escolhido por nós; o mesmo valor vai no campo "Verify token" do webhook
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# WhatsApp Cloud API. Passo a passo em docs/integrations/whatsapp.md
# IDs da conta e do número (não o telefone): caso de uso WhatsApp > configuração da API.
# Comece pelo número de teste; o número comercial definitivo vai em WHATSAPP_BUSINESS_NUMBER
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
# Pausa em segundos entre mensagens seguidas de um fluxo (a Meta não garante a ordem)
WHATSAPP_FLOW_SEND_DELAY=1.0
# Link da política de privacidade citado no primeiro contato (vazio: aviso sem link)
PRIVACY_POLICY_URL=

# Google (YouTube e Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo

# Voz (ElevenLabs e Twilio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AWS (SES e Route 53)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
ROUTE53_HOSTED_ZONE_ID=

# Anthropic
ANTHROPIC_API_KEY=

# Console CEO
OWNER_WHATSAPP_NUMBERS=
OWNER_COMMAND_PIN=

# Agenda
SCHEDULING_BUSINESS_HOURS=09:00-18:00
SCHEDULING_DEFAULT_DURATION_MIN=30

# Campanhas e sites
SHORTLINK_BASE_URL=https://go.brave2grow.com
SITES_BASE_DOMAIN=sites.brave2grow.com
SUBDOMAIN_RESERVATION_HOURS=72
DOMAIN_PURCHASE_ENABLED=False

# Ponte com o funil do brave2grow.com
FUNNEL_BRIDGE_BASE_URL=
FUNNEL_BRIDGE_HMAC_SECRET=
