[Unit]
Description=B2G Integrations Lab: Django com Gunicorn
After=network.target

[Service]
User=b2glab
Group=b2glab
WorkingDirectory=/srv/b2g-lab/app
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/b2g-lab/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 30 --access-logfile -
Restart=on-failure
RestartSec=5

# Isolamento: só a pasta var/ (SQLite e fila) é gravável
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/b2g-lab/app/var

[Install]
WantedBy=multi-user.target
